# 本文件只放占位示例，真实密钥请放在本地 .env。

# DashScope / 阿里百炼。若已复用 RepoPilot 的 REPOPILOT_GLM_API_KEY，可不重复配置。
DASH_SCOPE_API_KEY=
DASH_SCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASH_SCOPE_EMBEDDING_MODEL=text-embedding-v3
DASH_SCOPE_CHAT_MODEL=glm-5

# 专用文本重排，复用 DASH_SCOPE_API_KEY。跨地域/工作空间请填写对应原生 API 地址。
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=gte-rerank-v2
RAG_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RAG_RERANK_CANDIDATE_COUNT=12
RAG_RERANK_TIMEOUT_SECONDS=10

# 原始查询与改写查询融合（RRF）。
RAG_QUERY_FUSION_ENABLED=true
RAG_QUERY_FUSION_ORIGINAL_WEIGHT=0.4
RAG_QUERY_FUSION_REWRITTEN_WEIGHT=0.6
RAG_QUERY_FUSION_CANDIDATE_COUNT=12
RAG_QUERY_FUSION_RRF_K=60

# Pinecone。PINECONE_HOST 可留空，服务会通过控制面 API 自动查询 index host。
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_REGION=us-east-1
PINECONE_HOST=

# 文档生命周期。生产建议使用 jdbc，并先执行 src/main/resources/db/mysql/V1__document_lifecycle.sql。
RAG_LIFECYCLE_REPOSITORY=memory
RAG_DB_URL=
RAG_DB_USERNAME=
RAG_DB_PASSWORD=
RAG_DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# 原始文档存储。local 适合本地，s3 适合生产 MinIO/S3。
RAG_DOCUMENT_STORAGE_TYPE=local
RAG_DOCUMENT_STORAGE_DIR=data/rag-documents
RAG_S3_ENDPOINT=
RAG_S3_REGION=us-east-1
RAG_S3_BUCKET=
RAG_S3_ACCESS_KEY=
RAG_S3_SECRET_KEY=
RAG_S3_PATH_STYLE_ACCESS=true
RAG_S3_PREFIX=rag-documents

# 入库 Worker 恢复扫描。
RAG_INGESTION_RECOVERY_ENABLED=true
RAG_INGESTION_RECOVERY_FIXED_DELAY_MS=30000
RAG_INGESTION_RECOVERY_INITIAL_DELAY_MS=5000
RAG_INGESTION_RECOVERY_BATCH_SIZE=20

# 登录认证。默认关闭；生产开启时必须替换 token secret 和用户密码。
RAG_SECURITY_ENABLED=false
RAG_SECURITY_TOKEN_SECRET=change-this-token-secret-before-production
RAG_SECURITY_TOKEN_TTL_MINUTES=720
RAG_SECURITY_USERS=admin:admin123:ADMIN:*

RAG_SEGMENT_MAX_TOKENS=500
RAG_SEGMENT_OVERLAP_TOKENS=50
RAG_CONTEXT_BUDGET_TOKENS=3000

# 每个部署固定租户；生产租户需独立生命周期数据库与原文存储目录。
RAG_TENANT_ID=default
