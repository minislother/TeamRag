[Unit]
Description=TeamRag Knowledge Base
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=teamrag
WorkingDirectory=/opt/team-rag-knowledge-base
EnvironmentFile=-/opt/team-rag-knowledge-base/.env
Environment="JAVA_OPTS=-Xms512m -Xmx1024m"
ExecStart=/bin/sh -c 'exec java $JAVA_OPTS -jar /opt/team-rag-knowledge-base/current/app.jar'
Restart=always
RestartSec=10
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
